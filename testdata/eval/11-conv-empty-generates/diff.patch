+package log
+
+import "fmt"
+
+type Logger struct{ prefix string }
+
+func New(prefix string) *Logger { return &Logger{prefix: prefix} }
+
+func (l *Logger) Info(msg string) {
+	fmt.Println(l.prefix, msg)
+}
